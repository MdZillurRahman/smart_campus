source "https://rubygems.org"

ruby "3.2.10"

# ── Core ──────────────────────────────────────────────────────
gem "rails", "~> 8.1.2"
gem "pg", "~> 1.1"             # PostgreSQL adapter
gem "puma", ">= 5.0"           # Web server
gem "bootsnap", require: false # Faster Rails boot

# ── API & Serialization ───────────────────────────────────────
gem "jsonapi-serializer"       # Clean, controlled JSON responses

# ── Auth ──────────────────────────────────────────────────────
gem "bcrypt", "~> 3.1.7"       # Password hashing (has_secure_password)
gem "jwt"                      # JWT token generation + verification

# ── CORS ──────────────────────────────────────────────────────
gem "rack-cors"                # Allows React frontend to talk to Rails

# ── Timezone ──────────────────────────────────────────────────
gem "tzinfo-data", platforms: %i[ windows jruby ]

# -- Misc ---
gem "dotenv-rails", groups: [:development, :test]

group :development, :test do
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
  gem "bundler-audit", require: false  # Gem security scanning
  gem "brakeman", require: false       # Rails security analysis
end