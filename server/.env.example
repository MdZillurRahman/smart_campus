# Copy to server/.env (git-ignored) and fill in.
# Generate a secret with:  bin/rails secret
SECRET_KEY_BASE=replace-with-a-long-random-string

# Comma-separated frontend origins allowed by CORS (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# Production only (Render fills DATABASE_URL for you)
# DATABASE_URL=postgres://user:password@host:5432/dbname
# RAILS_ENV=production
